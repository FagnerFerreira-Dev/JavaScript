// ----------------------------------------------
// EXERCÍCIO 3 - TEMPLATE STRINGS
// ----------------------------------------------

// Crie uma função que receba um objeto livro.
//
// Exemplo:
//
// {
//     titulo: "Dom Casmurro",
//     autor: "Machado de Assis",
//     ano: 1899
// }
//
// A função deve retornar:
//
// O livro Dom Casmurro foi escrito por Machado de Assis em 1899.
//
// Utilize template strings.

let falaLivros = (...livro)  => {
    let livros = [];

    livro.forEach((el)=>{
        livros.push(el)
    })

    return livros
}


console.log(falaLivros(...livros1, ...livros2));


