// ----------------------------------------------
// EXERCÍCIO 1 - REST OPERATOR
// ----------------------------------------------

// Crie uma função chamada "somar".
//
// Ela deve receber qualquer quantidade de números
// e retornar a soma deles.
//
// Exemplo:
//
// somar(10, 20, 30); // 60
// somar(5, 10);      // 15
//
// Dica:
// Utilize o operador ...

function soma(...valores) {
    let total = 0

    valores.forEach(element => {
        total += element
    });
    return total
}

console.log(soma(100, 100, 100));


